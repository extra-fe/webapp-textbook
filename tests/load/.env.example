# tests/load/ 用 環境変数テンプレート
# ここの値は docker compose には自動で読まれない。次のどちらかで渡す。
#   - シェルの環境変数にする（docker-compose.yml が受け取るもののみ）
#   - docker compose run の -e で渡す（例: -e P95_THRESHOLD=1000）
# 実値を書いたファイルは絶対にコミットしないこと。

# 対象環境。ローカルで docker compose 経由なら host.docker.internal を使う
# （コンテナ内の localhost は k6 コンテナ自身を指す）
BASE_URL=http://host.docker.internal:3000

# ローカルでバックエンドを AUTH_ENABLED=false で起動しているときは true。
# IdP を呼ばずダミートークンを返す。
SKIP_AUTH=true

# ---- ROPG (Resource Owner Password Grant) で実トークンを取る場合 ----
# SKIP_AUTH=false のときだけ必要。
# Keycloak:
#   IDP_TOKEN_URL=http://localhost:8080/realms/sandbox/protocol/openid-connect/token
#
# 事前準備（Keycloak 管理コンソール）:
#   1. Clients → 対象クライアント → Settings → Capability config で
#      "Direct access grants" を ON にする（これが ROPG）
#   2. Credentials タブの Client secret を IDP_CLIENT_SECRET に入れる
#   3. 負荷テスト専用のユーザーを 1 つ作り、必要なロールを付ける
IDP_TOKEN_URL=http://localhost:8080/realms/sandbox/protocol/openid-connect/token
IDP_CLIENT_ID=sandbox-backend
IDP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
IDP_USERNAME=loadtest
IDP_PASSWORD=changeme
# ROPG で要求するスコープ（空でも可）
IDP_SCOPE=openid profile email

# p95 しきい値（ミリ秒）。ステージングでは 1000 など厳しめに。
P95_THRESHOLD=2000
