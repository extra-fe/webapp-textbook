DATABASE_URL="postgresql://postgres:password@localhost:15432/mydb"
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sandbox
AUTH_ENABLED=true
PORT=3000
CORS_ORIGIN="http://localhost:5173"
CORS_METHODS="GET,POST,PUT,PATCH,DELETE"
LOG_LEVEL=debug
KEYCLOAK_AUDIENCE=sandbox-api
# ロールキャッシュのTTL（秒）。既定30
ROLE_CACHE_TTL_SEC=30

# 開発時の N+1 検出用。NODE_ENV を書き忘れるとクエリログが出ない
NODE_ENV=development
PRISMA_LOG_LEVEL=query
SLOW_QUERY_THRESHOLD_MS=1000
